#!/bin/bash
# 串行执行完整发布回归及差异空白检查；无参数，任何子门禁失败即停止。
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

cd "$ROOT"
"$ROOT/.venv/bin/python" -m unittest discover -s tests -p 'test_*.py'
"$ROOT/scripts/test-macos-ui"
"$ROOT/scripts/test-aimes-table"
"$ROOT/scripts/test-workbook-e2e"
git diff --check

echo "Release test gate passed"
