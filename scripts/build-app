#!/bin/bash
# 构建并打包未签名 App；默认递增末位版本，--minor 用于新增或较大功能。
set -euo pipefail

if [[ "$#" -gt 1 ]]; then
  echo "Usage: $0 [--patch|--minor]" >&2
  exit 2
fi
case "${1:---patch}" in
  --patch) VERSION_BUMP=patch ;;
  --minor) VERSION_BUMP=minor ;;
  --help|-h) echo "Usage: $0 [--patch|--minor] (default: --patch)"; exit 0 ;;
  *) echo "Usage: $0 [--patch|--minor]" >&2; exit 2 ;;
esac

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILD_ROOT="${PP_FLOWHUB_BUILD_ROOT:-/tmp/pp-flowhub-build}"
OUTPUT_APP="$BUILD_ROOT/PP FlowHub.app"
STAGING_DIR="$(mktemp -d /tmp/workflow-assistant-build.XXXXXX)"
trap 'rm -rf "$STAGING_DIR"' EXIT
APP="$STAGING_DIR/PP FlowHub.app"
CONTENTS="$APP/Contents"
RESOURCES="$CONTENTS/Resources/project"
PYTHON_ENV="${TRAVELER_PYTHON_ENV:-$ROOT/.venv}"
DEPLOYMENT_TARGET="${MACOSX_DEPLOYMENT_TARGET:-26.0}"
TARGET_ARCH="${TRAVELER_ARCH:-$(uname -m)}"
SWIFT_TARGET="$TARGET_ARCH-apple-macosx$DEPLOYMENT_TARGET"
EXPECTED_BUNDLE_IDENTIFIER="com.pacificpride.ppflowhub"
INFO_PLIST="$ROOT/macos/Info.plist"

if ! BUNDLE_IDENTIFIER="$(/usr/bin/plutil -extract CFBundleIdentifier raw "$INFO_PLIST" 2>/dev/null)"; then
  echo "Unable to read CFBundleIdentifier from $INFO_PLIST" >&2
  exit 2
fi
if [[ "$BUNDLE_IDENTIFIER" != "$EXPECTED_BUNDLE_IDENTIFIER" ]]; then
  echo "Unexpected Bundle Identifier: $BUNDLE_IDENTIFIER" >&2
  echo "Expected fixed Bundle Identifier: $EXPECTED_BUNDLE_IDENTIFIER" >&2
  exit 2
fi

# 签名只由普通 macOS Terminal/Aqua 会话中的 install-app 执行。
# 本构建脚本可在 Codex 后台安全会话运行，不读取钥匙串，也不使用临时签名。

if [[ ! -x "$PYTHON_ENV/bin/python3" ]]; then
  echo "Missing Python environment: $PYTHON_ENV" >&2
  echo "Create it with: python3 -m venv .venv && .venv/bin/python3 -m pip install ." >&2
  exit 2
fi
if ! "$PYTHON_ENV/bin/python3" -c 'import agents, openpyxl, pydantic_core' >/dev/null 2>&1; then
  echo "Python environment is incomplete or built for the wrong CPU architecture: $PYTHON_ENV" >&2
  echo "Recreate it on this Mac and install pyproject.toml dependencies." >&2
  exit 2
fi
PYTHON_BASE="${TRAVELER_PYTHON_BASE:-$("$PYTHON_ENV/bin/python3" -c 'import sys; print(sys.base_prefix)')}"
if [[ ! -x "$PYTHON_BASE/bin/python3" || ! -f "$PYTHON_BASE/lib/libpython3.12.dylib" ]]; then
  echo "Portable Python base runtime is incomplete: $PYTHON_BASE" >&2
  echo "Set TRAVELER_PYTHON_BASE to the base prefix used to create .venv." >&2
  exit 2
fi

NODE_BIN="${TRAVELER_NODE:-}"
if [[ -z "$NODE_BIN" && -L "$ROOT/node_modules" ]]; then
  NODE_MODULES_TARGET="$(readlink "$ROOT/node_modules")"
  NODE_CANDIDATE="$(dirname "$NODE_MODULES_TARGET")/bin/node"
  if [[ -x "$NODE_CANDIDATE" ]]; then NODE_BIN="$NODE_CANDIDATE"; fi
fi
if [[ -z "$NODE_BIN" ]] && command -v node >/dev/null 2>&1; then
  NODE_BIN="$(command -v node)"
fi
if [[ -z "$NODE_BIN" || ! -x "$NODE_BIN" ]]; then
  echo "Node.js not found. Set TRAVELER_NODE to an executable Node.js path." >&2
  exit 2
fi

NODE_MODULES="${TRAVELER_NODE_MODULES:-$ROOT/node_modules}"
for package in playwright playwright-core; do
  if [[ ! -d "$NODE_MODULES/$package" ]]; then
    echo "Missing Node dependency: $NODE_MODULES/$package" >&2
    echo "Set TRAVELER_NODE_MODULES to the directory containing Playwright." >&2
    exit 2
  fi
done

# App 只复制 Node 可执行文件；若依赖 Homebrew 等非系统动态库，安装后会失效。
# 在 Swift 编译前明确拒绝，不静默更换运行环境，也不生成无法启动的 App。
if ! NODE_ARCHS="$(/usr/bin/lipo -archs "$NODE_BIN" 2>/dev/null)"; then
  echo "Unable to inspect Node architecture: $NODE_BIN" >&2
  exit 2
fi
if ! grep -Eq "(^|[[:space:]])${TARGET_ARCH}([[:space:]]|$)" <<<"$NODE_ARCHS"; then
  echo "Node architecture mismatch: target=$TARGET_ARCH, Node=$NODE_ARCHS ($NODE_BIN)" >&2
  exit 2
fi
NODE_LOADS="$(/usr/bin/otool -arch "$TARGET_ARCH" -L "$NODE_BIN" | awk 'NR > 1 { print $1 }')"
NODE_NON_SYSTEM_LOADS="$(printf '%s\n' "$NODE_LOADS" | awk '$1 !~ /^\/usr\/lib\// && $1 !~ /^\/System\/Library\// && $1 != "" { print $1 }')"
if [[ -n "$NODE_NON_SYSTEM_LOADS" ]]; then
  echo "Node has non-system dynamic-library dependencies and cannot be copied safely: $NODE_BIN" >&2
  echo "$NODE_NON_SYSTEM_LOADS" >&2
  echo "Set TRAVELER_NODE to a self-contained Node.js runtime." >&2
  exit 2
fi

mkdir -p "$BUILD_ROOT"
mkdir -p "$CONTENTS/MacOS" "$RESOURCES"
MODULE_CACHE="/tmp/pp-flowhub-module-cache"
mkdir -p "$MODULE_CACHE"
# 关闭当前 Swift 链接器默认的临时签名，使产物保持未签名；后续 Aqua 安装步骤添加开发者签名。
/usr/bin/xcrun --sdk macosx swiftc -target "$SWIFT_TARGET" -Xlinker -no_adhoc_codesign -module-cache-path "$MODULE_CACHE" -Xcc -fmodules-cache-path="$MODULE_CACHE" "$ROOT/tools/keychain_read.swift" -o "$STAGING_DIR/keychain-read" -framework Foundation -framework Security
/usr/bin/xcrun --sdk macosx swiftc -target "$SWIFT_TARGET" -Xlinker -no_adhoc_codesign -module-cache-path "$MODULE_CACHE" -Xcc -fmodules-cache-path="$MODULE_CACHE" -parse-as-library "$ROOT/macos/OperationLog.swift" "$ROOT/macos/TravelerAssistant.swift" "$ROOT/macos/AssistantView.swift" "$ROOT/macos/OrderDashboardView.swift" -o "$CONTENTS/MacOS/PPFlowHub" -framework SwiftUI -framework AppKit -framework AVFoundation -framework Speech -framework Security
cp "$INFO_PLIST" "$CONTENTS/Info.plist"
cp "$ROOT/assets/icons/AppIcon.png" "$CONTENTS/Resources/AppIcon.png"
cp -R "$ROOT/traveler_assistant" "$RESOURCES/"
cp -R "$ROOT/resources" "$RESOURCES/"
cp -R "$ROOT/scripts" "$RESOURCES/"
cp -R "$ROOT/vendor" "$RESOURCES/"
cp -RL "$PYTHON_ENV" "$RESOURCES/.venv"
cp -R "$ROOT/tools" "$RESOURCES/"
mkdir -p "$RESOURCES/bin" "$RESOURCES/node_modules"
mkdir -p "$RESOURCES/runtime/python/bin" "$RESOURCES/runtime/python/lib"
/usr/bin/rsync -a "$PYTHON_BASE/bin/" "$RESOURCES/runtime/python/bin/"
/usr/bin/rsync -a --exclude 'site-packages/' --exclude 'pkgconfig/' "$PYTHON_BASE/lib/" "$RESOURCES/runtime/python/lib/"
cp "$NODE_BIN" "$RESOURCES/bin/node"
cp "$STAGING_DIR/keychain-read" "$RESOURCES/bin/keychain-read"
cp -RL "$NODE_MODULES/playwright" "$RESOURCES/node_modules/playwright"
cp -RL "$NODE_MODULES/playwright-core" "$RESOURCES/node_modules/playwright-core"
# Homebrew 的 Node 文件可能只读；清理扩展属性前需要所有者写权限。
chmod u+w,a+x "$RESOURCES/bin/node"
chmod +x "$RESOURCES/bin/keychain-read"
chmod +x "$RESOURCES/runtime/python/bin/python3"
chmod +x "$RESOURCES/scripts/pp-flowhub"
find "$APP" -name .DS_Store -delete
find "$APP" -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete
find "$APP" -depth -type d -name __pycache__ -empty -delete
/usr/bin/xattr -cr "$APP"
PACKAGED_NODE="$RESOURCES/bin/node"
if ! PACKAGED_NODE_VERSION="$("$PACKAGED_NODE" --version 2>&1)"; then
  echo "Packaged Node failed to start: $PACKAGED_NODE" >&2
  echo "$PACKAGED_NODE_VERSION" >&2
  exit 2
fi
echo "Packaged Node verified: $PACKAGED_NODE_VERSION"
PACKAGED_PLAYWRIGHT="$RESOURCES/node_modules/playwright"
if ! "$PACKAGED_NODE" -e '
  const playwrightPath = process.argv[1];
  const playwright = require(playwrightPath);
  if (!playwright.chromium || typeof playwright.chromium.launch !== "function") {
    throw new Error("playwright.chromium.launch is unavailable");
  }
' "$PACKAGED_PLAYWRIGHT"; then
  echo "Packaged Playwright failed explicit absolute-path validation: $PACKAGED_PLAYWRIGHT" >&2
  exit 2
fi
if ! STAGED_BUNDLE_IDENTIFIER="$(/usr/bin/plutil -extract CFBundleIdentifier raw "$CONTENTS/Info.plist" 2>/dev/null)" \
  || [[ "$STAGED_BUNDLE_IDENTIFIER" != "$EXPECTED_BUNDLE_IDENTIFIER" ]]; then
  echo "Staged App Bundle Identifier changed unexpectedly: ${STAGED_BUNDLE_IDENTIFIER:-<missing>}" >&2
  exit 2
fi
if [[ ! -x "$CONTENTS/MacOS/PPFlowHub" ]]; then
  echo "Staged App executable path changed unexpectedly: $CONTENTS/MacOS/PPFlowHub" >&2
  exit 2
fi
# 所有打包检查通过后才分配版本；参考现有产物和安装包，避免旧源码使版本倒退。
# 先保存版本再发布产物；发布失败可以跳号，但不会复用已分配的版本。
NEXT_VERSION="$("$PYTHON_ENV/bin/python3" "$ROOT/tools/app_version.py" --bump "$VERSION_BUMP" \
  "$INFO_PLIST" "$OUTPUT_APP/Contents/Info.plist" "/Applications/PP FlowHub.app/Contents/Info.plist")"
for plist in "$CONTENTS/Info.plist" "$INFO_PLIST"; do
  /usr/bin/plutil -replace CFBundleShortVersionString -string "$NEXT_VERSION" "$plist"
  /usr/bin/plutil -replace CFBundleVersion -string "$NEXT_VERSION" "$plist"
done
rm -rf "$OUTPUT_APP"
/usr/bin/ditto --noextattr --noqtn "$APP" "$OUTPUT_APP"
echo "App version: $NEXT_VERSION"
echo "Unsigned App bundle assembled for Aqua Terminal signing: $OUTPUT_APP"
echo "Reminder: a new App was built. Run ./scripts/install-app from a normal macOS Terminal/Aqua session to sign and install it."
echo "$OUTPUT_APP"
